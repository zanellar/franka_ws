<?xml version="1.0"?>
<launch>

  <!-- Robot -->
  <arg name="robot" default="fr3"/>
  <arg name="arm_id" default="$(arg robot)"/>
  <arg name="use_gripper" default="false"/>

  <!-- Live joint-position margins; GUI is opt-in, including on headless runs. -->
  <arg name="joint_limit_diagnostics" default="true"/>
  <arg name="plot_joint_limits" default="false"/>
  <include file="$(find franka_example_controllers)/launch/joint_limit_diagnostics.launch">
    <arg name="arm_id" value="$(arg arm_id)"/>
    <arg name="joint_limit_diagnostics" value="$(arg joint_limit_diagnostics)"/>
    <arg name="plot_joint_limits" value="$(arg plot_joint_limits)"/>
  </include>

  <!-- Subscribers are armed at launch; files open on the first experiment request. -->
  <arg name="record_cbf" default="true"/>
  <arg name="state_publish_rate" default="1000"/>
  <arg name="gazebo_world" default="default"/>
  <node pkg="franka_gazebo" type="contact_diagnostics_bridge"
        name="contact_diagnostics_bridge" output="screen" if="$(arg record_cbf)">
    <param name="world" value="$(arg gazebo_world)"/>
  </node>
  <arg name="log_dir" default="$(env HOME)/.ros/directional_cbf"/>
  <node pkg="franka_example_controllers" type="record_directional_cbf.py"
        name="directional_cbf_recorder" output="screen" if="$(arg record_cbf)">
    <param name="runtime_environment" value="gazebo"/>
    <param name="output_dir" value="$(arg log_dir)"/>
    <param name="arm_id" value="$(arg arm_id)"/>
    <param name="gazebo_world" value="$(arg gazebo_world)"/>
  </node>

  <!-- Gazebo -->
  <arg name="headless" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="rviz" default="true"/>

  <!-- Directional kinetic-energy CBF -->
  <arg name="cbf_active" default="false"/>
  <arg name="Kmax" default="1.0"/>
  <arg name="alpha" default="1.0"/>
  <arg name="damping_ratio" default="1.0"/>

  <!-- Direction expressed in the robot base frame -->
  <arg name="direction_x" default="1.0"/>
  <arg name="direction_y" default="0.0"/>
  <arg name="direction_z" default="0.0"/>

  <!-- Numerical parameters -->
  <arg name="mobility_epsilon" default="1e-8"/>
  <arg name="derivative_filter_alpha" default="0.05"/>

  <!-- Optional trajectory publisher -->
  <arg name="start_trajectory" default="false"/>
  <arg name="trajectory" default="hold"/>
  <arg name="publish_rate" default="100"/>
  <!-- Joint initialization is implemented by linear; other trajectories ignore it. -->
  <arg name="enable_joint_initialization" default="true"/>

  <!-- Global parameters read by the directional CBF controller -->
  <param name="alpha"
         type="double"
         value="$(arg alpha)"/>

  <param name="cbf_active"
         type="bool"
         value="$(arg cbf_active)"/>

  <param name="Kmax"
         type="double"
         value="$(arg Kmax)"/>

  <param name="damping_ratio"
         type="double"
         value="$(arg damping_ratio)"/>

  <param name="direction_x"
         type="double"
         value="$(arg direction_x)"/>

  <param name="direction_y"
         type="double"
         value="$(arg direction_y)"/>

  <param name="direction_z"
         type="double"
         value="$(arg direction_z)"/>

  <param name="mobility_epsilon"
         type="double"
         value="$(arg mobility_epsilon)"/>

  <param name="derivative_filter_alpha"
         type="double"
         value="$(arg derivative_filter_alpha)"/>

  <!-- Keep URDF effort and velocity-triggered force limits enabled.
       FrankaHWSim reads this at initialization; restart Gazebo after changes. -->
  <param name="disable_gazebo_torque_limits" type="bool" value="false"/>

  <!-- Start Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="true"/>
    <arg name="gui" value="$(eval not arg('headless'))"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- Generate FR3 Gazebo URDF -->
  <param
      name="robot_description"
      command="xacro $(find franka_description)/robots/fr3/fr3.urdf.xacro
               gazebo:=true
               hand:=$(arg use_gripper)
               arm_id:=$(arg arm_id)"/>

  <!-- Franka Gazebo hardware simulation -->
  <rosparam
      command="load"
      file="$(find franka_gazebo)/config/franka_hw_sim.yaml"
      subst_value="true"/>

  <!-- Standard Gazebo controllers -->
  <rosparam
      command="load"
      file="$(find franka_gazebo)/config/sim_controllers.yaml"
      subst_value="true"/>

  <!-- Custom Franka example controllers -->
  <rosparam
      command="load"
      file="$(find franka_example_controllers)/config/franka_example_controllers.yaml"
      subst_value="true"/>

  <param name="cartesian_impedance_directional_kinetic_energy_cbf_controller/runtime_environment" value="gazebo"/>
  <!-- Override YAML only for this experiment, after all controller configs. -->
  <param name="franka_state_controller/publish_rate" value="$(arg state_publish_rate)"/>

  <!-- Spawn robot in bent non-singular configuration -->
  <arg name="unpause"
       value="$(eval '' if arg('paused') else '-unpause')"/>

  <node
      name="$(arg arm_id)_model_spawner"
      pkg="gazebo_ros"
      type="spawn_model"
      output="screen"
      args="-param robot_description
            -urdf
            -model $(arg arm_id)
            $(arg unpause)
            -J $(arg arm_id)_joint1 0.0
            -J $(arg arm_id)_joint2 -0.785398163
            -J $(arg arm_id)_joint3 0.0
            -J $(arg arm_id)_joint4 -2.35619449
            -J $(arg arm_id)_joint5 0.0
            -J $(arg arm_id)_joint6 1.57079632679
            -J $(arg arm_id)_joint7 0.785398163397"/>

  <!-- Start controllers after FrankaHWSim -->
  <node
      name="controller_spawner"
      pkg="controller_manager"
      type="spawner"
      output="screen"
      args="--wait-for initialized
            franka_state_controller
            cartesian_impedance_directional_kinetic_energy_cbf_controller"/>

  <!-- Robot state -->
  <node
      name="robot_state_publisher"
      pkg="robot_state_publisher"
      type="robot_state_publisher"
      output="screen"/>

  <node
      name="joint_state_publisher"
      pkg="joint_state_publisher"
      type="joint_state_publisher"
      output="screen">

    <rosparam param="source_list">
      [franka_state_controller/joint_states]
    </rosparam>

    <param name="rate" value="30"/>
  </node>

  <!-- Optional trajectory -->
  <node
    name="trajectory_publisher"
    pkg="franka_trajectory"
    type="$(arg trajectory)"
    output="screen"
    if="$(arg start_trajectory)">

  <param name="runtime_environment" value="gazebo"/>
  <param name="publish_rate"
         value="$(arg publish_rate)"/>
  <param name="arm_id" value="$(arg arm_id)"/>
  <param name="enable_joint_initialization" value="$(arg enable_joint_initialization)"/>
  <param name="joint_trajectory_controller" value="effort_joint_trajectory_controller"/>
  <param name="cartesian_controller"
         value="cartesian_impedance_directional_kinetic_energy_cbf_controller"/>
    <param name="recording_start_service" value="/directional_cbf_recorder/start"
           if="$(arg record_cbf)"/>
    <param name="recording_start_service" value="" unless="$(arg record_cbf)"/>
    <param name="directional_experiment_service"
           value="/cartesian_impedance_directional_kinetic_energy_cbf_controller/start_experiment"/>

  <param name="cbf_dynamic_reconfigure_service"
         value="/cartesian_impedance_directional_kinetic_energy_cbf_controller/dynamic_reconfigure_compliance_param_node/set_parameters"/>
</node>

  <!-- RViz -->
  <node
      name="rviz"
      pkg="rviz"
      type="rviz"
      output="screen"
      if="$(arg rviz)"
      args="-d $(find franka_example_controllers)/launch/rviz/franka_description_with_marker.rviz
            -f $(arg arm_id)_link0"/>

</launch>
